+WORKDIR /root
+RUN git clone --depth 1 https://github.com/CMU-SAFARI/UPMEM.git /tmp/UPMEM && \
+    mv /tmp/UPMEM/upmem-2023.1.0-Linux-x86_64 /root/upmem-2023.2.0-Linux-x86_64 && \
+    rm -rf /tmp/UPMEM
+RUN echo "source /root/upmem-2023.2.0-Linux-x86_64/upmem_env.sh" > /root/.bashrc
+
+WORKDIR /root/uPIMulator
